# Copy to .env and adjust. Every variable is validated at boot (apps/api/src/config/env.ts).
# Placeholders only: never commit real secrets.

NODE_ENV=development
APP_ENV=local
PORT=3000
LOG_LEVEL=info
# Set true behind a proxy / Cloud Run so rate limiting sees the client IP.
TRUST_PROXY=false

# Postgres. Locally: docker compose (pnpm services:up) or native (pnpm services:native start).
# Hosted (Neon): DATABASE_URL = pooled URL (…-pooler…, ?sslmode=require&pgbouncer=true),
#                DIRECT_DATABASE_URL = direct URL (used by prisma migrate).
DATABASE_URL=postgresql://qr:qr@127.0.0.1:5432/qr_ordering?schema=public
DIRECT_DATABASE_URL=postgresql://qr:qr@127.0.0.1:5432/qr_ordering?schema=public

# Redis: Socket.IO adapter + rate limiting only. Upstash: rediss://default:<token>@<host>:6379
# Leave empty to use in-memory fallbacks (single API instance only).
REDIS_URL=redis://127.0.0.1:6379
# Namespace for Redis keys (defaults to qr:<APP_ENV>) so environments can share one database.
REDIS_KEY_PREFIX=

# Generate each with: openssl rand -base64 48
SESSION_SECRET=change-me-session-secret-at-least-32-chars
QR_TOKEN_SECRET=change-me-qr-token-secret-at-least-32-chars

API_PUBLIC_URL=http://localhost:3000
CUSTOMER_APP_URL=http://localhost:5173
STAFF_APP_URL=http://localhost:5174
# Extra CORS origins, comma separated (the two app URLs are always allowed).
CORS_ORIGINS=
# Production: share a parent domain (e.g. .example.ng) so cookies are first-party.
COOKIE_DOMAIN=
# Defaults to true when NODE_ENV=production.
COOKIE_SECURE=

# Payments. With no PAYSTACK_SECRET_KEY the mock provider is used (local dev and tests).
# PAYMENTS_PROVIDER=paystack|mock
PAYMENTS_PROVIDER=
# Test key (sk_test_…) for local/staging, live key (sk_live_…) only in production.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Platform commission on each venue sub-account, in percent (0 = venue receives everything).
PAYSTACK_SUBACCOUNT_PERCENTAGE=0
# Minutes an unconfirmed online payment holds its share of the balance.
PAYMENT_RESERVATION_MINUTES=15
# Pending payments older than this are re-verified with Paystack by the scheduler.
RECONCILE_AFTER_MINUTES=3
# Pending payments still unconfirmed after this are marked failed.
PAYMENT_ABANDON_MINUTES=60
# Unpaid PREPAY orders are cancelled after this.
PREPAY_ORDER_EXPIRY_MINUTES=30
ENABLE_SCHEDULER=true

# Object storage for menu photos and logos.
# local = files under LOCAL_STORAGE_DIR served by the API (dev only)
# s3    = MinIO locally (docker compose) or Cloudflare R2 in production
STORAGE_DRIVER=s3
LOCAL_STORAGE_DIR=.data/storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_BUCKET=qr-ordering
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
PUBLIC_ASSET_BASE_URL=http://127.0.0.1:9000/qr-ordering

# Requests per IP per minute: all routes / sign-in + PIN login / public customer routes.
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
PUBLIC_RATE_LIMIT_PER_MINUTE=120

# Frontends (Vite, read at build time). Leave empty in dev: the Vite dev server proxies /v1.
VITE_API_URL=
